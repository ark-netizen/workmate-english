# 로컬 개발용 키 예시 — 실제 값은 .env.local 에 넣고 절대 커밋하지 마세요.
# Vercel 에서는 프로젝트 Settings → Environment Variables 에 동일 키를 등록합니다.

# ── 프론트(브라우저 노출 O) ─ VITE_ 접두사만 클라이언트에 포함됨
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# ── 서버 전용(비공개, 브라우저 노출 X) ─ 접두사 없이
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) — 키 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 알림 디스패치 크론 보호용 시크릿
CRON_SECRET=

# LLM 프로바이더 (기본 solar) / 모델 오버라이드(선택)
LLM_PROVIDER=solar
SOLAR_API_KEY=
SOLAR_MODEL=solar-pro2
