# 로컬 개발용 키 예시 — 실제 값은 .env.local 에 넣고 절대 커밋하지 마세요.
# 백엔드는 Supabase Edge Function이라, 서버 전용 값(SUPABASE_SERVICE_ROLE_KEY 등)은
# `supabase secrets set` 또는 대시보드(Edge Functions → Secrets)에 등록합니다.

# ── 프론트(브라우저 노출 O) ─ VITE_ 접두사만 클라이언트에 포함됨
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
# 로컬: http://127.0.0.1:54321/functions/v1 (supabase functions serve)
# 배포: https://<project-ref>.functions.supabase.co
VITE_API_BASE_URL=

# ── 서버 전용(비공개, 브라우저 노출 X) ─ 접두사 없이
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) — 키 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 알림 디스패치 크론 보호용 시크릿
CRON_SECRET=

# LLM 프로바이더 (기본 solar) / 모델 오버라이드(선택)
LLM_PROVIDER=solar
SOLAR_API_KEY=
SOLAR_MODEL=solar-pro2
